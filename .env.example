# Copy to .env and fill in yourself. Never commit .env. Load it with: uv run --env-file .env ...
# Postgres (docker compose maps the container to host port 5434)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/doc_copilot

# Embeddings: local = sentence-transformers all-MiniLM-L6-v2 (uv sync --extra local-embeddings), fake = offline hashing
EMBEDDER=local

# LLM: anthropic = real Claude (paid), fake = offline stand-in. Nothing paid runs unless this says anthropic.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
# USD per 1M tokens; check the current price list before a paid run.
LLM_PRICE_INPUT_PER_MTOK=0.10
LLM_PRICE_OUTPUT_PER_MTOK=0.50

# Retrieval / chunking
CHUNKING=baseline
TOP_K=8
MIN_SIMILARITY=0.25

# SEC EDGAR requires your own name and contact, e.g. "First Last your-contact"
SEC_USER_AGENT=

# Deployment guards
ACCESS_CODE=
RATE_LIMIT_PER_MINUTE=10
DAILY_QUERY_CAP=500
CORS_ORIGINS=http://localhost:3001
